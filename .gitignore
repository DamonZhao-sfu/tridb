# Python
.venv/
.venv-gpu/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/

# Build artifacts (MSVBASE fork — built on GX10, never committed)
/vendor/MSVBASE/
/build/
*.o
*.so
# LLVM bitcode emitted by PGXS when the toolchain has LLVM JIT enabled. Same
# category as *.o/*.so; two .bc files were already tracked before this rule and
# are left alone (gitignore does not untrack) — removing them is a separate call.
*.bc

# Data / corpora
/data/
*.bin
*.npy

# Benchmark output
/bench/out/
/baseline/volumes/

# Env / secrets
.env
.env.*
!.env.example
*.pem
*.key

# Editor
.vscode/
.idea/

# Installed skill copies (pinned via skills-lock.json; the install dir is not tracked)
/.agents/

# VectorDBBench writes an empty log dir on import
/logs/
/vendor/
